{
  "name": "solleva-reels",
  "private": true,
  "version": "0.1.0",
  "description": "Solleva Motion-System: Baukasten für Reels",
  "scripts": {
    "studio": "remotion studio",
    "katalog": "remotion render Katalog out/katalog.mp4 --concurrency=4",
    "still": "remotion still",
    "r04:assets": "mkdir -p public/r04 && cp assets/r04/higgsfield/welt-*.png assets/r04/higgsfield/obj-*.png public/r04/ && cp -r assets/r04/stimme public/r04/",
    "r04:stiltest": "remotion render R04Stiltest out/r04/stiltest-roh.mp4 --concurrency=4",
    "r04:reel": "remotion render R04Reel out/r04/reel04-roh.mp4 --concurrency=4",
    "r04:kurve": "esbuild tools/r04_kamerakurve.ts --bundle --platform=node --outfile=out/r04/kurve.cjs --log-level=warning && node out/r04/kurve.cjs > out/r04/kamerakurve.csv && python3 tools/r04_kamerapruefung.py out/r04/kamerakurve.csv --png out/r04/kamerakurve.png"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource/allura": "^5.3.0",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/permanent-marker": "^5.3.0",
    "@fontsource/special-elite": "^5.3.0",
    "@remotion/cli": "^4.0.543",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.543"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
